# ========================================================
*.mp4
*.mov
*.avi
*.webm
*.mkv
*.m4v
*.3gp
*.flv
*.wmv
/storage/app/private/videos/*
!/storage/app/private/videos/.gitignore
/public/storage

# ========================================================
